# True Agentic OS — orchestrator configuration.
# Copy to .env and `set -a; source .env; set +a` (or export the values) before
# running `scripts/fleet-desktop.sh up` and `npm start`. Every value is optional.

# ---- orchestrator ------------------------------------------------------------
# Bind address + port for the API, WebSocket stream and the built UI.
# Keep HOST on loopback unless the network is trusted: the API has no auth and
# every node runs Claude Code with --dangerously-skip-permissions.
HOST=127.0.0.1
PORT=4000

# Language of the orchestrator's narration and syntheses: en | ko
TAO_LANG=en

# Model the HOST `claude` uses for planning + synthesis (also editable at runtime
# through POST /api/settings).
STREAM_MODEL=claude-haiku-4-5-20251001

# Model started inside each node's terminal (passed as CLAUDE_MODEL to the container).
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ---- docker fleet -------------------------------------------------------------
TAO_IMAGE=tao-desktop:latest
TAO_NETWORK=tao-net
TAO_CONTAINER_PREFIX=tao-desk-
# Host interface the per-node noVNC ports are published on. The desktops have no
# VNC password, so keep this on loopback.
TAO_VNC_BIND=127.0.0.1
# node-N is published on TAO_VNC_BASE_PORT + N (6081, 6082, 6083, …)
TAO_VNC_BASE_PORT=6080
# Claude credentials mounted read-only into every node (relative to the repo root).
TAO_CREDS_PATH=secrets/claude-credentials.json

# Docker socket override. Auto-detected otherwise: /var/run/docker.sock, Colima,
# Docker Desktop (~/.docker/run) and OrbStack.
# DOCKER_SOCKET=/var/run/docker.sock
